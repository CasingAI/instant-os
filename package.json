{
  "name": "instant-app",
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "vendor:three": "bash scripts/vendor-three.sh",
    "vendor:rapier": "bash scripts/vendor-rapier.sh",
    "vendor:tokenizers": "bash scripts/vendor-tokenizers.sh",
    "vendor:runtime": "bash scripts/vendor-three.sh && bash scripts/vendor-rapier.sh",
    "assets:3d": "bash scripts/download-3d-assets.sh",
    "catalog:3d": "node scripts/generate-3d-catalog.mjs",
    "catalog:3d:vision": "node scripts/import-catalog-vision.mjs",
    "test:vscode-ts-resolve": "node --experimental-strip-types src/apps/vscode/vscode-typescript-module-resolve.gpt-tokenizer.test.ts",
    "test:quickjs": "node --experimental-strip-types src/quickjs/quickjs-sandbox.smoke-test.ts",
    "test:quickjs-cowsay": "node --experimental-strip-types src/quickjs/quickjs-cowsay.smoke-test.ts",
    "test:files-cow": "node --experimental-strip-types src/apps/files/files-storage-cow.test.ts",
    "test:terminal-controlled": "node --experimental-strip-types src/terminal/terminal-controlled.smoke-test.ts",
    "test:terminal-program-eval": "node --experimental-strip-types src/apps/terminal/terminal-repl-program-eval.smoke-test.ts",
    "vendor:quickjs-guest": "node scripts/vendor-quickjs-guest-builtins.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@huggingface/tokenizers": "^0.1.3",
    "buffer": "6.0.3",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.4.9",
    "fflate": "^0.8.3",
    "frimousse": "^0.3.0",
    "html-to-image": "^1.11.13",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "openai": "^6.42.0",
    "preact": "^10.29.1",
    "pricetoken": "0.13.10",
    "quickjs-emscripten": "^0.32.0",
    "three": "^0.184.0",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.12.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.0.12"
  }
}
