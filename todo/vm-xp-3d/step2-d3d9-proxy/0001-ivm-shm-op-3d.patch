@@ -449,6 +451,87 @@ export function decodeIvmFileFrame(data: Uint8Array): IvmFileFrame {
 
 // #endregion
 
+// #region 3D 命令批次解码（op=2，vm-xp-3d step2）
+
+/** 批次 payload 布局：u32 magic 'D3DB' + u32 count + count×(u32 op + 5×u32 args)。
+ * 与客机 d3d9-proxy.c 的 REC 常量与 shm_publish_batch 逐字节一致。 */
+export const IVM_3D_BATCH_MAGIC = 0x42334442
+
+/** 记录 opcode（与客机 REC_* 一致）。 */
+export const IVM_3D_REC = {
+  direct3dCreate9: 1,
+  getAdapterDisplayMode: 2,
+  createDevice: 3,
+  testCooperativeLevel: 4,
+  beginScene: 5,
+  endScene: 6,
+  clear: 7,
+  present: 8,
+  reset: 9,
+} as const
+
+export const IVM_3D_REC_NAMES: Record<number, string> = {
+  1: 'Direct3DCreate9',
+  2: 'GetAdapterDisplayMode',
+  3: 'CreateDevice',
+  4: 'TestCooperativeLevel',
+  5: 'BeginScene',
+  6: 'EndScene',
+  7: 'Clear',
+  8: 'Present',
+  9: 'Reset',
+}
+
+export type Ivm3dRecord = { op: number; args: [number, number, number, number, number] }
+export type Ivm3dBatch = { records: Ivm3dRecord[] }
+
+/** 解码 3D 命令批次；结构不符抛错（调用方丢帧，raw 读已 ACK 不阻塞信箱）。 */
+export function decodeIvm3dBatch(data: Uint8Array): Ivm3dBatch {
+  if (data.byteLength < 8) {
+    throw new Error(`3D 批次过短：${data.byteLength} 字节`)
+  }
+  const view = new DataView(data.buffer, data.byteOffset, data.byteLength)
+  const magic = view.getUint32(0, true)
+  if (magic !== IVM_3D_BATCH_MAGIC) {
+    throw new Error(`3D 批次 magic 不符：0x${magic.toString(16)}`)
+  }
+  const count = view.getUint32(4, true)
+  if (data.byteLength < 8 + count * 24) {
+    throw new Error(`3D 批次 payload 不足：count=${count} 只有 ${data.byteLength - 8} 字节`)
+  }
+  const records: Ivm3dRecord[] = []
+  for (let i = 0; i < count; i++) {
+    const base = 8 + i * 24
+    records.push({
+      op: view.getUint32(base, true),
+      args: [
+        view.getUint32(base + 4, true),
+        view.getUint32(base + 8, true),
+        view.getUint32(base + 12, true),
+        view.getUint32(base + 16, true),
+        view.getUint32(base + 20, true),
+      ],
+    })
+  }
+  return { records }
+}
+
+/** 编码 3D 命令批次（单测与模拟桥用；客机侧由 d3d9-proxy.c 手工拼字节）。 */
+export function encodeIvm3dBatch(records: readonly Ivm3dRecord[]): Uint8Array {
+  const bytes = new Uint8Array(8 + records.length * 24)
+  const view = new DataView(bytes.buffer)
+  view.setUint32(0, IVM_3D_BATCH_MAGIC, true)
+  view.setUint32(4, records.length, true)
+  records.forEach((record, i) => {
+    const base = 8 + i * 24
+    view.setUint32(base, record.op, true)
+    record.args.forEach((arg, j) => view.setUint32(base + 4 + j * 4, arg, true))
+  })
+  return bytes
+}
+
+// #endregion
+
 export type IvmShmMailbox = {
   readonly base: number
   /**
