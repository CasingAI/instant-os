+}
+
+/** G2H 3D 命令批次（vm-xp-3d step2：假 d3d9.dll 上行）；解码失败只丢帧
+ * （raw 读已 ACK，桥不会被卡住）。导出仅供单测。 */
+export function handleGuest3dBatch(target: VmAgentBinding, data: Uint8Array): void {
+  target.last3dActivityAt = Date.now()
+  let batch: Ivm3dBatch
+  try {
+    batch = decodeIvm3dBatch(data)
+  } catch (error) {
+    console.warn('[vm-d3d] iframe: 3D 批次解码失败（已确认丢弃）', error)
+    return
   }
+  const counts = new Map<string, number>()
+  for (const record of batch.records) {
+    const name = IVM_3D_REC_NAMES[record.op] ?? `op${record.op}`
+    counts.set(name, (counts.get(name) ?? 0) + 1)
+  }
+  const summary = [...counts.entries()].map(([name, n]) => `${name}×${n}`).join(' ')
+  console.info(`[vm-d3d] iframe: 收到 3D 命令批次（${batch.records.length} 条）${summary ? '：' + summary : ''}`)
+  target.onGuest3dBatch?.(batch)
 }
 
