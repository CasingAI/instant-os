+function test3dBatchDecode(): void {
+  // 编解码回环：Clear（含 float 位型参数）+ Present
+  const batch = encodeIvm3dBatch([
+    { op: IVM_3D_REC.clear, args: [2, 0x00ff00ff, 0x3f800000, 0, 0] },
+    { op: IVM_3D_REC.present, args: [0, 0, 0, 0, 0] },
+  ])
+  const decoded = decodeIvm3dBatch(batch)
+  assert.equal(decoded.records.length, 2)
+  assert.equal(decoded.records[0]?.op, IVM_3D_REC.clear)
+  assert.deepEqual(decoded.records[0]?.args, [2, 0x00ff00ff, 0x3f800000, 0, 0])
+  assert.equal(decoded.records[1]?.op, IVM_3D_REC.present)
+
+  // 坏 magic 丢帧
+  const badMagic = encodeIvm3dBatch([{ op: IVM_3D_REC.present, args: [0, 0, 0, 0, 0] }]).slice()
+  new DataView(badMagic.buffer).setUint32(0, 0x12345678, true)
+  assert.throws(() => decodeIvm3dBatch(badMagic), /magic/)
+  // 过短
+  assert.throws(() => decodeIvm3dBatch(new Uint8Array(4)), /过短/)
+  // count 与 payload 不符
+  const lying = new Uint8Array(8)
+  const view = new DataView(lying.buffer)
+  view.setUint32(0, IVM_3D_BATCH_MAGIC, true)
+  view.setUint32(4, 5, true)
+  assert.throws(() => decodeIvm3dBatch(lying), /payload 不足/)
+
+  // 信箱全链路：op=2 帧走 G2H → readGuestToHostRaw 取走 + ACK（保留 op 位）
+  const { mem } = fakeMemory()
+  const mailbox = createIvmShmMailbox(
+    {
+      read_memory: (offset, length) => mem.slice(offset, offset + length),
+      write_memory: (blob, offset) => mem.set(blob, offset),
+    },
+    0,
+  )
+  const payload = encodeIvm3dBatch([{ op: IVM_3D_REC.direct3dCreate9, args: [32, 0, 0, 0, 0] }])
+  writeHeader(mem, IVM_SHM_G2H_OFFSET, { seq: 1, len: payload.length })
+  mem.set(payload, IVM_SHM_G2H_OFFSET + 16)
+  const statusView = new DataView(mem.buffer)
+  statusView.setUint32(
+    IVM_SHM_G2H_OFFSET + 8,
+    packIvmShmStatus(IVM_SHM_STATUS_READY, IVM_SHM_OP_3D),
+    true,
+  )
+  const raw = mailbox.readGuestToHostRaw()
+  assert.ok(raw, 'op=2 帧必须能被原始读取走')
+  assert.equal(raw.op, IVM_SHM_OP_3D)
+  assert.equal(decodeIvm3dBatch(raw.data).records[0]?.op, IVM_3D_REC.direct3dCreate9)
+  assert.equal(readStatus(mem, IVM_SHM_G2H_OFFSET), packIvmShmStatus(IVM_SHM_STATUS_READ, IVM_SHM_OP_3D))
+}
